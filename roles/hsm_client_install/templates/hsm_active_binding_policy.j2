/* ============================================================================
 * GPFS Policy for Automatic Active Server Binding
 * ============================================================================
 * Generated by Ansible for {{ inventory_hostname }}
 * Date: {{ ansible_date_time.iso8601 }}
 * 
 * Purpose: Automatically set dmapi.IBMServ attribute for files based on
 *          their location (fileset) to enable Petascale multi-server
 *          load distribution.
 * 
 * How it works:
 * - Files in each fileset are automatically bound to their designated server
 * - The dmapi.IBMServ attribute determines which TSM server backs up the file
 * - This enables load distribution across multiple TSM servers
 * ============================================================================
 */

{% for server in sp_servers %}
RULE 'BindTo{{ server.name }}'
  LIST '{{ server.name }}_files'
  WHERE PATH_NAME LIKE '{{ server.domain }}/%'
  DO SET_DMATTR('dmapi.IBMServ', '{{ server.name }}')

{% endfor %}

/* ============================================================================
 * End of Policy
 * ============================================================================
 * To apply this policy manually:
 *   mmapplypolicy /gpfs_main -P /tmp/hsm_active_binding_policy.txt -I defer
 * 
 * To verify binding:
 *   mmlsattr -d -L <file> | grep IBMServ
 * ============================================================================
 */